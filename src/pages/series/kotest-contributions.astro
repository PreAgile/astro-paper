---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const title = "Kotest 기여 설계 기록";
const description =
  "Kotlin 테스트 프레임워크에 기여하며 public API, Kotlin Multiplatform, 동시성, property testing의 경계를 설계·검증한 과정을 정리할 예정입니다.";
const articles = [
  { order: 1, label: "Metadata API", title: "테스트 메타데이터는 왜 Map 하나로 끝나지 않았는가", summary: "등록 시점의 가변성, 실행 시점의 불변성, 계층형 설정 병합을 새 public API로 설계한 기록입니다.", href: "/posts/kotest-test-metadata-api-design/", status: "발행" },
  { order: 2, label: "Kotlin Multiplatform", title: "JVM에서 되는 구현이 Kotlin Multiplatform에서 안전하지 않은 이유", summary: "타입 안전 assertion의 Native linker 실패를 재현하고, API를 보존한 채 수정한 과정을 다룹니다.", status: "집필 예정 · PR #5789 / #5828" },
  { order: 3, label: "Scoped comparison", title: "전역 비교 규칙을 요청 범위로 내린 이유", summary: "병렬 테스트의 global mutable resolver 문제를 context-propagated override로 바꾼 설계입니다.", status: "집필 예정 · PR #6010" },
  { order: 4, label: "Property testing", title: "property test의 실패를 같은 최소 반례로 다시 여는 방법", summary: "seed, evaluation index, shrink path를 분리해 결정적인 실패 재현을 만드는 작업입니다.", status: "PR 상태 확인 후 집필 · #6097 / #6098" },
  { order: 5, label: "Diagnostic UX", title: "테스트 실패 메시지도 API다", summary: "diff, JSON parser, schema DSL, assertion chaining을 개발자 진단 경험으로 연결합니다.", status: "집필 예정 · PR #5835 / #5795 / #5807 / #5756" },
];
---

<Layout title={`${title} | ${SITE.title}`} {description} pageType="collection" alternateLinks={[
  { lang: "ko", href: new URL("/series/kotest-contributions/", SITE.website).href },
  { lang: "x-default", href: new URL("/series/kotest-contributions/", SITE.website).href },
]}>
  <Header />
  <main id="main-content" class="app-layout py-10">
    <header class="mb-10 border-b border-border pb-8">
      <p class="mb-2 text-sm font-semibold text-accent">KOTEST CONTRIBUTIONS</p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-4 max-w-3xl text-lg">{description}</p>
    </header>
    <section class="app-prose max-w-none">
      <h2>이 시리즈가 다룰 것</h2>
      <p>Kotest는 Kotlin의 assertion, 테스트 DSL·실행 엔진, property-based testing과 Kotlin Multiplatform 지원을 제공하는 테스트 프레임워크다. 이 시리즈는 기여 PR을 결과 목록으로 나열하지 않고, 공개 라이브러리에서 호환성·상태 소유권·실행 모델을 어떻게 결정하고 검증했는지를 다룬다.</p>
      <ol class="not-prose mt-8 space-y-5">
        {articles.map(article => (
          <li class="rounded-xl border border-border p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-sm font-semibold text-accent">{article.order}편 · {article.label}</span>
              <span class="rounded-full bg-muted px-3 py-1 text-xs">{article.status}</span>
            </div>
            <h2 class="mt-3 text-xl font-bold">{article.href ? <a class="underline-offset-4 hover:underline" href={article.href}>{article.title}</a> : article.title}</h2>
            <p class="mt-2">{article.summary}</p>
          </li>
        ))}
      </ol>
    </section>
  </main>
  <Footer />
</Layout>
