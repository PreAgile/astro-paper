---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const title = "운영 장애를 설계 경계로 되돌린 기록";
const description =
  "외부 의존성의 실패를 브라우저나 재시도로 뭉개지 않고, 세션 소유권·배포 원자성·자원 풀·메시지 계약으로 분해해 해결한 백엔드 운영 설계 시리즈입니다.";
const articles = [
  {
    order: 1,
    label: "Atomic deployment",
    title: "실패의 대부분은 브라우저가 아니라 배포 경로에 있었다",
    summary:
      "대량 수집 실패를 응답 형태와 호출 계층으로 분해해 라우팅 설정의 비원자적 갱신을 찾아내고, 단일 rename 교체와 수집 중 배포 가드로 고친 기록입니다.",
    status: "집필 예정 · 재현·PR 근거 확보",
  },
  {
    order: 2,
    label: "Session ownership",
    title: "동시 로그인 하나가 여러 환경을 만들던 문제",
    summary:
      "동일 계정의 동시 요청이 세션·프록시 할당을 증폭시키던 경로를 로그인 single-flight로 제한하고, 과도한 전역 락과 성급한 분산 락을 피한 이유를 다룹니다.",
    status: "집필 예정 · 운영 trace·PR 근거 확보",
  },
  {
    order: 3,
    label: "Resource-pool architecture",
    title: "프록시는 문자열이 아니라 관측 가능한 자원이었다",
    summary:
      "여러 공급자와 연결 유형을 공통 endpoint 모델로 정규화하고, 회전·TTL 격리·결과 분류·카디널리티 제한 관측을 설계한 과정을 다룹니다.",
    status: "집필 예정 · 운영 지표 보강 필요",
  },
  {
    order: 4,
    label: "Messaging boundary",
    title: "메시지 큐를 붙인 것이 아니라 처리 계약을 옮겼다",
    summary:
      "계약 schema부터 broker adapter, 다중 대기열 구독, 플랫폼 adapter, 결과 전달까지 단계적으로 전환하며 영구 적체를 막은 과정을 다룹니다.",
    status: "집필 예정 · PR·E2E 근거 확보",
  },
];
---

<Layout
  title={`${title} | ${SITE.title}`}
  {description}
  pageType="collection"
  alternateLinks={[
    { lang: "ko", href: new URL("/series/operational-boundaries/", SITE.website).href },
    { lang: "x-default", href: new URL("/series/operational-boundaries/", SITE.website).href },
  ]}
>
  <Header />
  <main id="main-content" class="app-layout py-10">
    <header class="mb-10 border-b border-border pb-8">
      <p class="mb-2 text-sm font-semibold text-accent">OPERATING SYSTEM BOUNDARIES</p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-4 max-w-3xl text-lg">{description}</p>
    </header>
    <section class="app-prose max-w-none">
      <h2>이 시리즈가 증명하려는 것</h2>
      <p>
        외부 시스템의 오류를 특정 라이브러리나 재시도로 덮지 않습니다. 어떤 상태를 누가
        소유하는지, 배포가 어떤 중간 상태를 노출하는지, 어떤 결과를 다시 처리해도 되는지를
        실제 trace·재현 실험·PR·테스트로 연결합니다.
      </p>
      <p>
        외부 플랫폼·내부 서비스·호스트 이름과 자격증명은 공개하지 않습니다. 공개 가능한
        기술적 불변식과 검증 방법만 남깁니다.
      </p>
      <ol class="not-prose mt-8 space-y-5">
        {articles.map(article => (
          <li class="rounded-xl border border-border p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-sm font-semibold text-accent">{article.order}편 · {article.label}</span>
              <span class="rounded-full bg-muted px-3 py-1 text-xs">{article.status}</span>
            </div>
            <h2 class="mt-3 text-xl font-bold">{article.title}</h2>
            <p class="mt-2">{article.summary}</p>
          </li>
        ))}
      </ol>
    </section>
  </main>
  <Footer />
</Layout>
