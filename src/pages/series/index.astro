---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const series = [
  {
    eyebrow: "BUILDING REPUTATION-POOL",
    title: "reputation-pool 설계 기록",
    description:
      "동시성 계약, open-core 경계, 멀티테넌시와 수평 확장 한계를 실제 코드·PR·검증으로 연결한 시리즈입니다.",
    href: "/series/reputation-pool/",
    status: "5편 발행 · 운영 데이터 후속",
  },
  {
    eyebrow: "HETEROGENEOUS WORKLOAD PIPELINE",
    title: "서로 다른 작업을 함께 처리하는 파이프라인 설계 기록",
    description:
      "브라우저 자동화, API 호출, 세션과 외부 쓰기를 큐·상태·멱등성 경계로 분리한 운영 설계 시리즈입니다.",
    href: "/series/heterogeneous-workload-pipeline/",
    status: "3편 발행 · 2편 집필 예정",
  },
  {
    eyebrow: "KOTEST CONTRIBUTIONS",
    title: "Kotest 기여 설계 기록",
    description:
      "Kotlin 테스트 프레임워크에 기여하며 public API, Kotlin Multiplatform, 동시성, property testing의 경계를 설계·검증한 기록입니다.",
    href: "/series/kotest-contributions/",
    status: "1편 발행 · 4편 집필 예정",
  },
  {
    eyebrow: "OPERATING SYSTEM BOUNDARIES",
    title: "운영 장애를 설계 경계로 되돌린 기록",
    description:
      "세션 소유권, 배포 원자성, 자원 풀과 메시지 계약으로 외부 의존성의 실패를 분해한 운영 설계 시리즈입니다.",
    href: "/series/operational-boundaries/",
    status: "시리즈 공개 · 4편 집필 예정",
  },
];
---

<Layout
  title={`시리즈 | ${SITE.title}`}
  description="실제 코드, 실패 시나리오와 운영 제약을 연결한 Forward Engineering의 설계 기록입니다."
  pageType="collection"
  alternateLinks={[
    { lang: "ko", href: new URL("/series/", SITE.website).href },
    { lang: "x-default", href: new URL("/series/", SITE.website).href },
  ]}
>
  <Header />
  <main id="main-content" class="app-layout py-10">
    <header class="mb-10 border-b border-border pb-8">
      <p class="mb-2 text-sm font-semibold text-accent">SERIES</p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">설계 기록</h1>
      <p class="mt-4 max-w-3xl text-lg">
        완성된 결과만 소개하지 않습니다. 처음의 가정, 그 가정을 깨뜨린 테스트와 운영 제약,
        수정한 계약과 아직 남은 한계를 실제 코드와 함께 기록합니다.
      </p>
    </header>

    <section class="not-prose grid gap-5">
      {
        series.map(item => (
          <a
            href={item.href}
            class="rounded-xl border border-border p-6 transition-colors hover:border-accent"
          >
            <p class="text-sm font-semibold text-accent">{item.eyebrow}</p>
            <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
              <h2 class="text-2xl font-bold">{item.title}</h2>
              <span class="rounded-full bg-muted px-3 py-1 text-xs">{item.status}</span>
            </div>
            <p class="mt-3 max-w-3xl">{item.description}</p>
          </a>
        ))
      }
    </section>
  </main>
  <Footer />
</Layout>
